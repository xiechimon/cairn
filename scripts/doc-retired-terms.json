{
  "terms": [
    {
      "id": "adr-number",
      "pattern": "\\b[Aa][Dd][Rr][Ss]?[-_ /]?#?\\d{3,4}\\b",
      "canary": "ADR 0026",
      "reason": "no ADR file is tracked; cite the spec section or design document that holds the decision"
    },
    {
      "id": "pr-evidence-gate",
      "pattern": "\\bpr-evidence\\b",
      "canary": "pr-evidence-gate.py",
      "reason": "there is no pull request evidence gate; AGENTS.md (Ship) is how work lands"
    },
    {
      "id": "manual-queue-main",
      "pattern": "\\bqueue/main\\b(?! release:)",
      "canary": "git push origin HEAD:queue/main",
      "reason": "nobody lands through queue/main by hand; scripts/ops/push-queue.mjs is the one landing route"
    },
    {
      "id": "design-rules-file",
      "pattern": "\\bDESIGN-RULES\\.md\\b",
      "canary": "apps/web/DESIGN-RULES.md",
      "reason": "the file was removed; rule rows live in the Rules section of docs/design/surfaces/*.md"
    },
    {
      "id": "doc-drift-sweep",
      "pattern": "\\bdoc-drift\\b",
      "canary": "node scripts/doc-drift.mjs",
      "reason": "the spec drift sweep was removed; living docs are kept true by the change that retires a mechanism"
    },
    {
      "id": "chief-stop-waiting-to-retry",
      "pattern": "chief-turn-waiting-to-retry|CHIEF_TURN_WAITING_TO_RETRY",
      "canary": "chief-turn-waiting-to-retry",
      "reason": "Stop ends a turn that waits to run again; docs/design/chief-stop-visibility.md describes it"
    }
  ],
  "baseline": {
    "adr-number": {
      ".claude/skills/verify-cairn/features/agent-detail.md": 2,
