{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.cairn",
        "~/.config",
        "~/Library/Application Support/@cairn",
        "~/Library/Application Support/Claude",
        "~/.local/share/cairn",
        "~/.local/share/devin",
        "~/.local/share/opencode",
        "~/.claude",
        "~/.claude.json",
        "~/.claude.json.backup",
        "~/.codex",
        "~/.pi",
        "~/.gemini",
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.docker",
        "~/.kube",
        "~/.password-store",
        "~/.netrc",
        "~/.git-credentials",
        "~/.npmrc",
        "~/.zshrc",
        "~/.zshenv",
        "~/.zprofile",
        "~/.bashrc",
        "~/.bash_profile",
        "~/.profile",
        "~/Library/pnpm/rc",
        "~/Library/Keychains",
        "~/Library/Application Support/Google/Chrome",
        "~/Library/Application Support/Chromium",
        "~/Library/Application Support/Firefox",
        "~/Library/Safari",
        "~/Library/Cookies",
        "~/Library/Mail",
        "~/Library/Messages"
      ],
      "allowRead": [
        "~/.cairn/workspaces",
        "~/.cairn/plans",
        "~/.cairn/tools",
        "~/.config/git",
        "~/Library/Application Support/@cairn/desktop/runner/workspaces",
        "~/Library/Application Support/@cairn/desktop/runner-web-tools"
      ],
      "allowWrite": [
        "~/.cache",
        "~/.npm",
        "~/.cargo/registry",
        "~/go/pkg/mod",
        "~/Library/pnpm",
        "~/Library/Caches",
        "~/.cairn/plans"
      ],
      "denyWrite": [
        "~/.cache/lane-tmp",
        "~/Library/pnpm/rc",
        ".claude",
        "CLAUDE.md",
        "CLAUDE.local.md",
        "AGENTS.md",
        "AGENTS.local.md"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.cairn/cairnwright.private-key.pem)",
      "Read(~/.cairn/config.json)",
      "Read(~/.cairn/server/**)",
      "Read(~/.cairn/server.hdd-old/**)",
      "Read(~/.cairn/token)",
      "Read(~/.cairn/machine.json)",
      "Read(~/.cairn/device.json)",
      "Read(~/.cairn/daemon.json)",
      "Read(~/.cairn/agent-runtime/**)",
      "Read(~/.cairn/chat-sessions/**)",
      "Read(~/.config/**)",
      "Read(~/Library/Application Support/@cairn/desktop/home/**)",
      "Read(~/Library/Application Support/@cairn/desktop/otel.env)",
      "Read(~/Library/Application Support/@cairn/desktop/logs/**)",
      "Read(~/Library/Application Support/@cairn/desktop/blob_storage/**)",
      "Read(~/Library/Application Support/@cairn/desktop/runner/devin/**)",
      "Read(~/Library/Application Support/@cairn/desktop/runner/machine.json)",
      "Read(~/Library/Application Support/@cairn/desktop/runner/claude/**)",
      "Read(~/Library/Application Support/@cairn/desktop/runner/daemon.log)",
      "Read(~/.local/share/cairn/**)",
      "Read(~/.local/share/devin/**)",
      "Read(~/.local/share/opencode/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude.json.backup)",
      "Read(~/.npmrc)",
      "Read(~/.zshrc)",
      "Read(~/.zshenv)",
      "Read(~/.zprofile)",
      "Read(~/.bashrc)",
      "Read(~/.bash_profile)",
      "Read(~/.profile)",
      "Read(~/Library/Application Support/Claude/**)",
      "Read(~/.codex/**)",
      "Read(~/.pi/**)",
      "Read(~/.gemini/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/**)",
      "Read(~/.kube/**)",
      "Read(~/.password-store/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/Library/pnpm/rc)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Application Support/Chromium/**)",
      "Read(~/Library/Application Support/Firefox/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/Library/Messages/**)"
    ]
  }
}
