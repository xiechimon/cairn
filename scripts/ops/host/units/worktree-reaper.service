[Unit]
Description=Remove clean, idle Cairn worktrees whose work is merged, closed or pushed

[Service]
Type=oneshot
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=HTTP_PROXY=http://127.0.0.1:7890
ExecStart=/usr/bin/node %h/.cairn/tools/worktree-reaper.mjs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cairn-worktree-reaper
