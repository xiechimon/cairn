[Unit]
Description=Cairn server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/cairn-server
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=NODE_USE_ENV_PROXY=1
EnvironmentFile=-%h/.config/cairn/server.env
ExecStart=/usr/bin/env node --max-old-space-size=1024 dist/index.mjs
MemoryMax=1536M
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
