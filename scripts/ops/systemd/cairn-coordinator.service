[Unit]
Description=Cairn Coordinator sidecar
After=cairn-server.service

[Service]
Type=simple
WorkingDirectory=%h/Code/AgentProjects/cairn-exec/apps/coordinator
Environment=PATH=%h/.local/share/mise/installs/node/24/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=CAIRN_COORDINATOR_SERVER_URL=http://127.0.0.1:8787
ExecStart=%h/.local/share/mise/installs/node/24/bin/node --max-old-space-size=512 --import tsx src/main.ts
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
