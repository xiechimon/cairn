[Unit]
Description=Cairn executor daemon
After=cairn-server.service

[Service]
Type=simple
WorkingDirectory=%h/Code/AgentProjects/cairn-exec/apps/daemon
Environment=PATH=%h/.local/share/mise/installs/node/24/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/mise/installs/node/24/bin/node dist/cli.mjs start -f --server http://127.0.0.1:8787
Restart=always
RestartSec=15
UMask=0077

[Install]
WantedBy=default.target
