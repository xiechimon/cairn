[Unit]
Description=Re-evaluate stale Cairn review-gate checks when GitHub Actions schedules are delayed

[Service]
Type=oneshot
EnvironmentFile=%h/.config/cairn/review-gate-watchdog.env
Environment=REPO=xiechimon/cairn
Environment=CAIRN_WATCHDOG_STATE=%h/.local/state/review-gate/watchdog.json
ExecStart=/bin/bash -c 'cd "$CAIRN_CHECKOUT" && exec "$NODE_BIN" scripts/ops/review-gate/codex-gate-watchdog.mjs'
TimeoutStartSec=2min
UMask=0077

[Install]
WantedBy=default.target
