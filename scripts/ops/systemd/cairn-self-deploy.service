[Unit]
Description=Cairn self-deployment watcher

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=%h/.config/cairn/deploy.env
ExecStart=/bin/bash ${CAIRN_DEPLOY_BUILD_CHECKOUT}/scripts/ops/deploy-watch.sh
StandardOutput=append:%h/.local/state/cairn-deploy/deploy-watch.log
StandardError=append:%h/.local/state/cairn-deploy/deploy-watch.log
TimeoutStartSec=45min
