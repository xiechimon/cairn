[Unit]
Description=Cairn Orb egress relay on a unix socket

[Service]
Type=simple
Environment=PATH=%h/.local/share/fnm/node-versions/v24.14.0/installation/bin:/usr/local/bin:/usr/bin:/bin
Environment=CAIRN_ORB_ALLOWED_PORTS=80,443,22
Environment=CAIRN_ORB_EGRESS_SOCKET=%t/cairn-orb-egress/egress.sock
RuntimeDirectory=cairn-orb-egress
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ExecStartPre=/usr/bin/install -d -m 0700 %t/cairn-orb-egress
WorkingDirectory=%h/Code/AgentProjects/cairn-exec
ExecStart=%h/.local/share/fnm/node-versions/v24.14.0/installation/bin/node %h/Code/AgentProjects/cairn-exec/scripts/ops/orb/egress-relay.mjs
Restart=on-failure
RestartSec=2
UMask=0077
TasksMax=256
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
