{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "drizzle-orm": ["../../../apps/server/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../../apps/server/node_modules/drizzle-orm/*"]
    }
  },
  "include": ["worker.ts", "sqlite-compat.worker.ts"]
}
