[Unit]
Description=Cairn Orb proxy relay
StartLimitIntervalSec=0

[Service]
Environment=CAIRN_ORB_NODE=/usr/local/lib/cairn-orb/node
ExecStart=/usr/local/lib/cairn-orb/egress-relay.sh
Restart=on-failure
RestartSec=2
TasksMax=256
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
