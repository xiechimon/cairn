[Unit]
Description=Cairn GitHub App installation token mint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node %h/Code/cairn/ops/app-token-mint/mint.mjs
Environment=CAIRN_APP_TOKEN_MINT_CONFIG=%h/.cairn/cairn-bot.json
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
