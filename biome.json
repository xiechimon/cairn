{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/web/src/**",
      "apps/web/index.html",
      "apps/web/vite.config.ts",
      "apps/web/postcss.config.js",
      "apps/web/tsconfig.json",
      "apps/web/package.json",
      "packages/shared/src/**",
      "packages/shared/test/**/*.ts",
      "packages/shared/package.json",
      "packages/shared/tsconfig.json",
      "apps/server/src/**",
      "apps/server/test/**/*.ts",
      "apps/server/package.json",
      "apps/server/tsconfig.json",
      "apps/server/drizzle.config.ts",
      "apps/server/build.mjs",
      "apps/server/scripts/stage-web.mjs",
      "apps/daemon/src/**",
      "apps/daemon/test/**/*.ts",
      "apps/daemon/build.mjs",
      "apps/daemon/externals.mjs",
      "apps/daemon/scripts/**",
      "apps/daemon/package.json",
      "apps/daemon/tsconfig.json",
      "integration/test/**/*.ts",
      "integration/eval/**/*.mts",
      "integration/*.ts",
      "integration/package.json",
      "vitest.config.ts",
      "parity/*.mjs",
      "scripts/**",
      "package.json",
      "pnpm-workspace.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@earendil-works/*", "@earendil-works/*/*"],
                "message": "Seam discipline: pi packages are consumed only in apps/daemon/src/backend/ (behind the AgentBackend seam) and apps/server/src/coordinator/runtime/ (the in-server Coordinator); other modules import the seam interface from @cairn/shared."
              },
              {
                "group": [
                  "@modelcontextprotocol/sdk",
                  "@modelcontextprotocol/sdk/*",
                  "@modelcontextprotocol/sdk/*/*"
                ],
                "message": "Seam discipline: the MCP SDK is consumed only by services/mcp-face.ts on the server and src/backend/ on the daemon."
              },
              {
                "group": [
                  "@anthropic-ai/claude-agent-sdk",
                  "@anthropic-ai/claude-agent-sdk/*",
                  "@anthropic-ai/claude-agent-sdk/*/*"
                ],
                "message": "Seam discipline (spec 17 T1, 01 §5): claude-agent-sdk is consumed only through AgentBackend in apps/daemon/src/backend/claude-code.ts; the backend override also covers @earendil-works/*."
              },
              {
                "group": [
                  "@agentclientprotocol/sdk",
                  "@agentclientprotocol/sdk/*",
                  "@agentclientprotocol/sdk/*/*",
                  "@agentclientprotocol/claude-agent-acp",
                  "@agentclientprotocol/claude-agent-acp/*",
                  "@agentclientprotocol/claude-agent-acp/*/*",
                  "@zed-industries/codex-acp",
                  "@zed-industries/codex-acp/*",
                  "@zed-industries/codex-acp/*/*"
                ],
                "message": "Seam discipline (ACP): ACP SDK and adapters may only be consumed through apps/daemon/src/backend/."
              },
              {
                "group": ["**/legacy/agent-layer/*"],
                "message": "Seam discipline: the legacy agent-layer resolver is imported only by the boot migration in apps/server/src/db/client.ts and by its tests; delete the module once 0116 has been live for a release."
              },
              {
                "group": ["@opentelemetry/*", "@opentelemetry/*/*", "@langfuse/*"],
                "message": "Seam discipline (observability-4): the OpenTelemetry SDK is consumed only through the bridge packages/shared/src/otel.ts, and convention keys (@opentelemetry/semantic-conventions, @langfuse/core) only through packages/shared/src/genai-conventions.ts."
              }
            ],
            "paths": {
              "cron-parser": "Seam discipline (01 §3/§7.3): cron-parser is consumed only through the Scheduler seam (the scheduling loop in 02 §9.2).",
              "simple-git": "Seam discipline (01 §3/S10, §7.3): GitOps uses a thin wrapper around system git; simple-git is prohibited.",
              "isomorphic-git": "Seam discipline (01 §3/S10, §7.3): GitOps uses a thin wrapper around system git; isomorphic-git is prohibited (no http-backend/worktree support).",
              "e2b": "Seam discipline: the E2B SDK is consumed only through the thin bridge module apps/daemon/src/orb/e2b-client.ts."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/shared/src/otel.ts",
        "packages/shared/src/genai-conventions.ts",
        "packages/shared/src/langfuse.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/daemon/src/backend/**",
        "apps/server/src/coordinator/runtime/**",
        "apps/server/src/db/client.ts",
        "apps/server/src/legacy/**",
        "apps/server/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/services/schedules.ts",
        "apps/server/src/services/scheduler.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/daemon/src/orb/e2b-client.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/services/mcp-face.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/daemon/test/**/*.test.ts",
        "apps/server/test/**/*.test.ts",
        "integration/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off",
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/field.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/input-group.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/**",
        "!apps/server/src/coordinator/runtime/**",
        "!apps/server/src/db/client.ts",
        "!apps/server/src/legacy/**",
        "!apps/server/src/services/mcp-face.ts",
        "!apps/server/src/services/schedules.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@earendil-works/*", "@earendil-works/*/*"],
                    "message": "Seam discipline: pi packages are consumed only in apps/daemon/src/backend/ (behind the AgentBackend seam) and apps/server/src/coordinator/runtime/ (the in-server Coordinator); other modules import the seam interface from @cairn/shared."
                  },
                  {
                    "group": [
                      "@modelcontextprotocol/sdk",
                      "@modelcontextprotocol/sdk/*",
                      "@modelcontextprotocol/sdk/*/*"
                    ],
                    "message": "Seam discipline: the MCP SDK is consumed only by services/mcp-face.ts on the server and src/backend/ on the daemon."
                  },
                  {
                    "group": [
                      "@anthropic-ai/claude-agent-sdk",
                      "@anthropic-ai/claude-agent-sdk/*",
                      "@anthropic-ai/claude-agent-sdk/*/*"
                    ],
                    "message": "Seam discipline (spec 17 T1, 01 §5): claude-agent-sdk is consumed only through AgentBackend in apps/daemon/src/backend/claude-code.ts; the backend override also covers @earendil-works/*."
                  },
                  {
                    "group": [
                      "@agentclientprotocol/sdk",
                      "@agentclientprotocol/sdk/*",
                      "@agentclientprotocol/sdk/*/*",
                      "@agentclientprotocol/claude-agent-acp",
                      "@agentclientprotocol/claude-agent-acp/*",
                      "@agentclientprotocol/claude-agent-acp/*/*",
                      "@zed-industries/codex-acp",
                      "@zed-industries/codex-acp/*",
                      "@zed-industries/codex-acp/*/*"
                    ],
                    "message": "Seam discipline (ACP): ACP SDK and adapters may only be consumed through apps/daemon/src/backend/."
                  },
                  {
                    "group": ["**/legacy/agent-layer/*"],
                    "message": "Seam discipline: the legacy agent-layer resolver is imported only by the boot migration in apps/server/src/db/client.ts and by its tests; delete the module once 0116 has been live for a release."
                  },
                  {
                    "group": ["@opentelemetry/*", "@opentelemetry/*/*", "@langfuse/*"],
                    "message": "Seam discipline (observability-4): the OpenTelemetry SDK is consumed only through the bridge packages/shared/src/otel.ts, and convention keys (@opentelemetry/semantic-conventions, @langfuse/core) only through packages/shared/src/genai-conventions.ts."
                  },
                  {
                    "group": [
                      "**/github-connection",
                      "**/github-connection.js",
                      "**/github-connection.ts"
                    ],
                    "importNamePattern": "(githubTokenOrNull|openGithubToken|\\*)",
                    "message": "Identity seam: use branded App/User token providers. Legacy untyped getters are private to github-connection.ts."
                  }
                ],
                "paths": {
                  "cron-parser": "Seam discipline (01 §3/§7.3): cron-parser is consumed only through the Scheduler seam (the scheduling loop in 02 §9.2).",
                  "simple-git": "Seam discipline (01 §3/S10, §7.3): GitOps uses a thin wrapper around system git; simple-git is prohibited.",
                  "isomorphic-git": "Seam discipline (01 §3/S10, §7.3): GitOps uses a thin wrapper around system git; isomorphic-git is prohibited (no http-backend/worktree support).",
                  "e2b": "Seam discipline: the E2B SDK is consumed only through the thin bridge module apps/daemon/src/orb/e2b-client.ts."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/coordinator/runtime/**",
        "apps/server/src/db/client.ts",
        "apps/server/src/legacy/**",
        "apps/server/src/services/mcp-face.ts",
        "apps/server/src/services/schedules.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/github-connection",
                      "**/github-connection.js",
                      "**/github-connection.ts"
                    ],
                    "importNamePattern": "(githubTokenOrNull|openGithubToken|\\*)",
                    "message": "Identity seam: use branded App/User token providers. Legacy untyped getters are private to github-connection.ts."
                  }
                ],
                "paths": {}
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
