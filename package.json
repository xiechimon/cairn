{
  "name": "cairn",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -n web,server,daemon -c blue,magenta,green \"pnpm dev:web\" \"pnpm dev:server\" \"pnpm dev:daemon\"",
    "dev:web": "pnpm --filter @cairn/web dev",
    "dev:server": "pnpm --filter @xiechimon/cairn dev",
    "dev:daemon": "pnpm --filter @xiechimon/cairn-cli dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @cairn/web build && pnpm --filter @xiechimon/cairn start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "eval:sample-failures": "pnpm --filter @xiechimon/cairn exec node --import tsx src/eval-sample-failures-cli.ts",
    "eval:review-score": "pnpm --filter @xiechimon/cairn exec node --import tsx src/eval-review-score-cli.ts",
    "traj:export": "pnpm --filter @xiechimon/cairn exec node --import tsx src/trajectory-export-cli.ts",
    "traj:push": "pnpm --filter @xiechimon/cairn exec node --import tsx src/trajectory-push-cli.ts",
    "traj:label": "pnpm --filter @xiechimon/cairn exec node --import tsx src/trajectory-label-cli.ts",
    "traj:attribution": "pnpm --filter @xiechimon/cairn exec node --import tsx src/trajectory-attribution-summary-cli.ts",
    "traj:reflect": "pnpm --filter @xiechimon/cairn exec node --import tsx src/trajectory-reflect-cli.ts",
    "traj:backfill": "pnpm --filter @xiechimon/cairn exec node --import tsx src/trajectory-backfill-cli.ts",
    "traj:curate": "pnpm --filter @xiechimon/cairn exec node --import tsx src/trajectory-curate-cli.ts",
    "traj:failure-replay": "pnpm --filter @xiechimon/cairn exec node --import tsx src/trajectory-failure-replay-cli.ts",
    "rel:report": "pnpm --filter @xiechimon/cairn exec node --import tsx src/reliability-report-cli.ts",
    "lint": "biome ci .",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "prepush": "node scripts/prepush.mjs",
    "pr:check": "node scripts/pr-body-check.mjs",
    "spec:parse": "node scripts/spec-parse-gate.mjs",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "catalog:",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lucide-static": "^1.48.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
