#!/bin/sh
set -eu

cd "$(dirname "$0")/.."
if command -v corepack >/dev/null 2>/dev/null; then corepack enable; fi
pnpm install --frozen-lockfile
pnpm exec husky
if ! test -x .husky/_/pre-push; then
  echo "Setup failed: .husky/_/pre-push is missing or not executable."
  exit 1
fi
PLAYWRIGHT_BROWSERS_PATH="$HOME/.cache/ms-playwright" pnpm exec playwright install chromium
