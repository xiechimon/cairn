table inet cairn_guard {
  set gateway {
    type ipv4_addr
  }
  set private4 {
    type ipv4_addr
    flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 224.0.0.0/4, 240.0.0.0/4 }
  }
  set private6 {
    type ipv6_addr
    flags interval
    elements = { ::/128, ::1/128, fc00::/7, fe80::/10, ff00::/8 }
  }
  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    ip saddr @gateway tcp dport { 5900, 5901 } accept
  }
  chain output {
    type filter hook output priority 0; policy accept;
    oif lo accept
    ct state established,related accept
    ip daddr @gateway udp dport 53 accept
    ip daddr @gateway tcp dport 53 accept
    ip daddr @private4 drop
    ip6 daddr @private6 drop
  }
}
