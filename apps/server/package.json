{
  "name": "@xiechimon/cairn",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cairn": "dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "web",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node build.mjs",
    "prepack": "pnpm --filter @cairn/web build && node build.mjs && node scripts/stage-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db-check.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@cairn/shared": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "cron-parser": "5.10.1",
    "diff": "catalog:",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "hono": "4.13.8",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
