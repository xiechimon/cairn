{
  "name": "@xiechimon/cairn",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiechimon/cairn.git",
    "directory": "apps/server"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cairn": "dist/index.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "web",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node build.mjs",
    "prepack": "pnpm --filter @cairn/web build && node build.mjs && node scripts/stage-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db-check.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "jose": "6.2.12",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "web-push": "^3.6.7",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@cairn/shared": "workspace:*",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@hono/node-server": "2.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@silvia-odwyer/photon": "0.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/mailparser": "3.9.0",
    "@types/nodemailer": "8.0.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.2",
    "cron-parser": "5.10.1",
    "diff": "catalog:",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "hono": "4.13.19",
    "image-size": "2.0.3",
    "imapflow": "2.12.1",
    "mailparser": "3.14.5",
    "nodemailer": "10.6.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "undici": "8.12.4",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
