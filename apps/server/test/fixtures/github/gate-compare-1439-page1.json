      "raw_url": "https://github.com/xiechimon/pacman/raw/f9c4f852292592395e882e1d900ca215a1aafce5/docs%2Fverify%2F1430%2Fmanifest-cdp.json",
      "contents_url": "https://api.github.com/repos/xiechimon/pacman/contents/docs%2Fverify%2F1430%2Fmanifest-cdp.json?ref=f9c4f852292592395e882e1d900ca215a1aafce5",
      "patch": "@@ -0,0 +1,48 @@\n+{\n+  \"light\": {\n+    \"chromium\": \"153.0.8010.12\",\n+    \"manifestUrl\": \"http://localhost:5300/manifest.webmanifest\",\n+    \"manifestErrors\": [],\n+    \"manifest\": {\n+      \"theme_color\": \"#1a1612\",\n+      \"background_color\": \"#1a1612\",\n+      \"display\": \"standalone\",\n+      \"name\": \"Pacman\"\n+    },\n+    \"themeColorMetas\": [\n+      {\n+        \"content\": \"#f3eee5\",\n+        \"media\": \"(prefers-color-scheme: light)\"\n+      },\n+      {\n+        \"content\": \"#f3eee5\",\n+        \"media\": \"(prefers-color-scheme: dark)\"\n+      }\n+    ],\n+    \"canvasToken\": \"#f3eee5\",\n+    \"dataTheme\": \"light\"\n+  },\n+  \"dark\": {\n+    \"chromium\": \"153.0.8010.12\",\n+    \"manifestUrl\": \"http://localhost:5300/manifest.webmanifest\",\n+    \"manifestErrors\": [],\n+    \"manifest\": {\n+      \"theme_color\": \"#1a1612\",\n+      \"background_color\": \"#1a1612\",\n+      \"display\": \"standalone\",\n+      \"name\": \"Pacman\"\n+    },\n+    \"themeColorMetas\": [\n+      {\n+        \"content\": \"#1a1612\",\n+        \"media\": \"(prefers-color-scheme: light)\"\n+      },\n+      {\n+        \"content\": \"#1a1612\",\n+        \"media\": \"(prefers-color-scheme: dark)\"\n+      }\n+    ],\n+    \"canvasToken\": \"#1a1612\",\n+    \"dataTheme\": \"dark\"\n+  }\n+}"
    },
    {
      "sha": "29dde1f28b46723c0ab00441aba83712d1f032b0",
      "filename": "docs/verify/1430/manifest-cdp.mjs",
      "status": "added",
      "additions": 26,
      "deletions": 0,
      "changes": 26,
      "blob_url": "https://github.com/xiechimon/pacman/blob/f9c4f852292592395e882e1d900ca215a1aafce5/docs%2Fverify%2F1430%2Fmanifest-cdp.mjs",
      "raw_url": "https://github.com/xiechimon/pacman/raw/f9c4f852292592395e882e1d900ca215a1aafce5/docs%2Fverify%2F1430%2Fmanifest-cdp.mjs",
      "contents_url": "https://api.github.com/repos/xiechimon/pacman/contents/docs%2Fverify%2F1430%2Fmanifest-cdp.mjs?ref=f9c4f852292592395e882e1d900ca215a1aafce5",
      "patch": "@@ -0,0 +1,26 @@\n+import { chromium } from '@playwright/test';\n+const base = 'http://localhost:5300';\n+const browser = await chromium.launch();\n+const out = {};\n+for (const theme of ['light', 'dark']) {\n+  const ctx = await browser.newContext({ colorScheme: theme });\n+  const page = await ctx.newPage();\n+  await page.goto(`${base}/app?scenario=01`, { waitUntil: 'networkidle' });\n+  await page.evaluate((t) => localStorage.setItem('pacman-theme', t), theme);\n+  await page.reload({ waitUntil: 'networkidle' });\n+  const cdp = await ctx.newCDPSession(page);\n+  const m = await cdp.send('Page.getAppManifest');\n+  const parsed = m.data ? JSON.parse(m.data) : null;\n+  out[theme] = {\n+    chromium: browser.version(),\n+    manifestUrl: m.url,\n+    manifestErrors: m.errors,\n+    manifest: parsed ? { theme_color: parsed.theme_color, background_color: parsed.background_color, display: parsed.display, name: parsed.name } : null,\n+    themeColorMetas: await page.evaluate(() => [...document.querySelectorAll('meta[name=\"theme-color\"]')].map(m => ({ content: m.content, media: m.getAttribute('media') }))),\n+    canvasToken: await page.evaluate(() => getComputedStyle(document.documentElement).getPropertyValue('--canvas').trim()),\n+    dataTheme: await page.evaluate(() => document.documentElement.dataset.theme),\n+  };\n+  await ctx.close();\n+}\n+await browser.close();\n+console.log(JSON.stringify(out, null, 2));"
    }
  ]
