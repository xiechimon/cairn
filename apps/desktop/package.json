{
  "name": "@cairn/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Cairn desktop app: runs the bundled Cairn server and local Runner on Electron's Node and opens its web UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiechimon/cairn.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "dist/main.mjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "stage-server": "node scripts/stage-server.mjs",
    "stage-runner": "node scripts/stage-runner.mjs",
    "stage-agent-desktop": "node scripts/stage-agent-desktop.mjs",
    "build": "node build.mjs",
    "start": "node scripts/pack.mjs --start",
    "dist:mac": "node scripts/pack.mjs --mac",
    "dist:linux": "node scripts/pack.mjs --linux --publish never",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-mac.mjs release/mac-arm64/Cairn.app release/smoke.png",
    "smoke:linux": "node scripts/smoke-linux.mjs"
  },
  "devDependencies": {
    "@cairn/shared": "workspace:*",
    "@electron/osx-sign": "1.3.3",
    "@playwright/test": "catalog:",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "electron-liquid-glass": "1.1.1",
    "esbuild": "0.28.2",
    "typescript": "catalog:"
  }
}
