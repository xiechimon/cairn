{
  "name": "@cairn/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Cairn desktop app for macOS: runs the bundled Cairn server on Electron's Node and opens its web UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiechimon/cairn.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "dist/main.mjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "stage": "node scripts/stage-server.mjs",
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cairn/shared": "workspace:*",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "typescript": "catalog:"
  }
}
