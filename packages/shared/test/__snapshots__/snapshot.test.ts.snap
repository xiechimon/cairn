  },
  {
    "method": "POST",
    "note": "body {title,spec}（r3 §3.1）+ 可选 tagIds[]（r9 §3.4 实测携带位）",
    "path": "/api/projects/{id}/todos",
  },
  {
    "method": "POST",
    "note": "body {name,color} → 201 tag record 全形（r9 §3.4 实测；#309）",
    "path": "/api/projects/{id}/tags",
  },
  {
    "method": "POST",
    "note": "开始/重跑；body {todoIds[],assignment,withPlan}（r5 §3.4）",
    "path": "/api/projects/{id}/builds",
  },
  {
    "method": "POST",
    "note": "→ 202 {delegated:true}（r3 §3.6）",
    "path": "/api/builds/{id}/merge",
  },
  {
    "method": "POST",
    "note": "确认/驳回回路（02 §4.2/r5 §4）",
    "path": "/api/builds/{id}/steps",
  },
  {
    "method": "POST",
    "path": "/api/teams/{id}/providers",
  },
  {
    "method": "POST",
    "path": "/api/teams/{id}/mcp-servers",
  },
  {
    "method": "POST",
    "note": "→ 201 {id}（r5 §1/§8 补录）",
    "path": "/api/teams/{id}/agents",
  },
  {
    "method": "POST",
    "note": "XMON-109（spec 13 回摆）：写路径——建技能目录（body {name,description,files[]}，frontmatter 是唯一真值）；→ 201 record",
    "path": "/api/skills",
    "query": [
      "teamId",
    ],
  },
  {
    "method": "PUT",
    "note": "XMON-109（spec 13 回摆）：写路径——覆写式更新（列出者覆写、未列者保留；改名须携带新 SKILL.md）",
    "path": "/api/teams/{id}/skills/{sid}",
  },
  {
    "method": "POST",
    "note": "#1170：导入通道——body {localPath} 或 {url} 二选一（本地目录 / GitHub 公共仓子目录）；落盘复用 createLocalSkill 校验；SSRF/路径守卫见 services/skill-import.ts",
    "path": "/api/teams/{id}/skills/import",
  },
  {
    "method": "POST",
    "note": "#1170：按记录的来源重拉（技能 id 不变，复用 updateLocalSkill 覆写语义）；无来源记录 = 409",
    "path": "/api/teams/{id}/skills/{sid}/refresh",
  },
  {
    "method": "POST",
    "path": "/api/schedules",
  },
  {
    "method": "POST",
    "note": "形状保留、内容自选；可空实现",
    "path": "/api/analytics/first-touch",
  },
  {
    "method": "POST",
    "note": "埋点端点（r3 §8.2 PostHog 风格 base64 batch）；复刻可空实现（02 §6.1）",
    "path": "/_mp/api/track",
  },
  {
    "method": "PATCH",
    "path": "/api/teams/{id}/providers/{pid}",
  },
  {
    "method": "PATCH",
    "path": "/api/teams/{id}/agents/{aid}",
  },
  {
    "method": "PATCH",
    "note": "绑定 Agent（r5 §2 抓包）",
    "path": "/api/teams/{id}/chief",
  },
  {
    "method": "POST",
    "note": "#231 [设计]：签发授权 URL（state 入册，TTL 10min 单次核销）",
    "path": "/api/teams/{id}/providers/oauth/{preset}/authorize",
  },
  {
    "method": "GET",
    "note": "#231 [设计]：收码 → token 密封落 provider 行（02 §8）→ 302 回 providers 页",
    "path": "/api/oauth/callback",
    "query": [
      "code",
      "state",
      "error",
    ],
  },
]
`;

exports[`protocol vocabulary snapshot (02 §5/§6 canonical) > worktree contract (02 §5.5) 1`] = `
{
  "baseRepoSubpath": "<projectId>/repo",
  "branchPrefix": "cairn/conv-",
  "checkpointResetArgs": [
    "reset --hard",
    "clean -fd",
  ],
  "concurrencyGuard": "projectLock(projectId)",
  "forceSyncCopy": "丢弃代码修改并删除非忽略的未跟踪文件；保留忽略内容。仅本次生效。",
  "mergeArgs": "merge --no-edit",
  "remoteBranchDiverged": "remote branch diverged",
  "retryBudgetCanon": "~2 min typical, ~8 min worst on /done's path",
  "staleCleanupArgs": [
    "worktree remove --force",
    "worktree prune",
    "branch -D",
  ],
  "taskDirLayout": "<workspacesRoot>/<conversationId>",
}
`;

