                              "state",
                            ],
                            "type": "object",
                          },
                          "maxItems": 64,
                          "type": "array",
                        },
                        "stepId": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "items",
                        "stepId",
                        "at",
                      ],
                      "type": "object",
                    },
                    "type": {
                      "const": "agent_todo",
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "todo",
                  ],
                  "type": "object",
                },
              ],
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "preview_reset",
                  "type": "string",
                },
              },
              "required": [
                "type",
              ],
              "type": "object",
            },
          ],
        },
        "type": {
          "const": "conversation",
          "type": "string",
        },
      },
      "required": [
        "type",
        "conversationId",
        "event",
      ],
      "type": "object",
    },
  ],
}
`;

