                  "enum": [
                    "checking",
                    "ready",
                    "not-applicable",
                    "unavailable",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "state",
                "invocation",
                "generation",
                "revision",
              ],
              "type": "object",
            },
            "devin": {
              "additionalProperties": false,
              "properties": {
                "installed": {
                  "type": "boolean",
                },
                "models": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "type": "string",
                      },
                      "inServerThinkingDefault": {
                        "enum": [
                          "off",
                          "minimal",
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max",
                        ],
                        "type": "string",
                      },
                      "inServerThinkingLevels": {
                        "items": {
                          "enum": [
                            "off",
                            "minimal",
                            "low",
                            "medium",
                            "high",
                            "xhigh",
                            "max",
                          ],
