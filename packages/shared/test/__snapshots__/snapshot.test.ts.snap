                  "type": "null",
                },
              ],
            },
            "status": {
              "enum": [
                "pending",
                "running",
                "synced",
                "failed",
              ],
              "type": "string",
            },
            "teamId": {
              "type": "string",
            },
          },
          "required": [
            "id",
            "buildId",
            "machineId",
            "teamId",
            "directory",
            "ref",
            "commit",
            "force",
            "status",
            "errorMessage",
            "createdAt",
            "startedAt",
            "finishedAt",
          ],
          "type": "object",
        },
        "type": {
          "const": "branch_sync",
          "type": "string",
        },
      },
      "required": [
        "type",
        "sync",
      ],
      "type": "object",
    },
  ],
}
`;

