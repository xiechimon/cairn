                "version",
                "channels",
              ],
              "type": "object",
            },
            "antigravity": {
              "additionalProperties": false,
              "properties": {
                "authenticated": {
                  "type": "boolean",
                },
                "installed": {
                  "type": "boolean",
                },
                "models": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string",
                      },
                      "name": {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string",
                      },
                      "thinkingDefault": {
                        "enum": [
                          "off",
                          "minimal",
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max",
                        ],
                        "type": "string",
                      },
                      "thinkingLevels": {
                        "items": {
                          "enum": [
                            "off",
                            "minimal",
                            "low",
                            "medium",
                            "high",
                            "xhigh",
                            "max",
                          ],
                          "type": "string",
                        },
                        "maxItems": 7,
                        "type": "array",
                      },
                    },
                    "required": [
                      "id",
                      "name",
                    ],
                    "type": "object",
                  },
                  "maxItems": 500,
                  "type": "array",
                },
                "source": {
                  "enum": [
                    "local",
                    "managed",
                  ],
                  "type": "string",
                },
                "version": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "installed",
              ],
              "type": "object",
            },
            "antigravityOAuthProfile": {
              "const": true,
              "type": "boolean",
            },
            "antigravitySubscriptionModels": {
              "const": true,
              "type": "boolean",
            },
            "antigravityUsage": {
              "const": true,
              "type": "boolean",
            },
            "browser": {
              "const": true,
              "type": "boolean",
            },
            "browserSecretFill": {
              "const": true,
              "type": "boolean",
            },
            "claimGeneration": {
              "const": true,
              "type": "boolean",
            },
            "codexLogin": {
              "additionalProperties": false,
              "properties": {
                "expiresAt": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "state": {
                  "enum": [
                    "ok",
                    "expired",
                    "absent",
